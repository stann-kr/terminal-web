# =====================================================
# TERMINAL — 환경변수 템플릿
# 실제 값은 .env.local에 작성하고 절대 커밋하지 말 것
# =====================================================

# Cloudflare Workers 배포 인증
# 발급: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# D1 데이터베이스 바인딩은 wrangler.toml에서 설정됨
# [[d1_databases]]
# binding = "DB"
# database_name = "terminal-db"
# database_id = "<wrangler d1 create 실행 후 발급된 ID>"

# Signal 메일 발송(npm run signal:mail). 실제 값은 .env에 둔다.
# 수신 거부 링크 서명 secret(Worker의 SIGNAL_UNSUBSCRIBE_SECRET과 같은 값)
SIGNAL_UNSUBSCRIBE_SECRET=
# 회신과 mailto 수신 거부를 받을 메일 주소(TERMINAL 프로젝트 메일 terminal@stann.kr).
SIGNAL_REPLY_TO=

# FAUST 출입 명단(authon) 재전송(npm run authon:sync). 실제 값은 .env에 둔다.
# authon-worker의 INTERNAL_API_SECRET과 같은 값(terminal-web Worker secret AUTHON_SYNC_SECRET과도 같음)
AUTHON_SYNC_SECRET=
# 받는 주소. 비우면 https://guest.faustseoul.kr/api/internal/sync-guest
AUTHON_SYNC_URL=
