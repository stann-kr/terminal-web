{
  "dependencies": {
    "@chenglou/pretext": "0.0.9",
    "@gsap/react": "2.1.2",
    "@opennextjs/cloudflare": "^1.18.1",
    "@react-three/fiber": "9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@types/three": "^0.169.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "12.23.12",
    "gsap": "3.15.0",
    "next": "^16.3.3",
    "patch-package": "^8.0.1",
    "postprocessing": "^6.39.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "three": "0.179.1",
    "use-scramble": "^2.2.15",
    "wrangler": "^4.121.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "name": "terminal-web",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/check-token-sync.mjs",
    "build": "cross-env NODE_ENV=production next build",
    "build:worker": "npm run build:worker:production",
    "build:worker:development": "opennextjs-cloudflare build --env development",
    "build:worker:production": "opennextjs-cloudflare build --env production",
    "db:check-history": "node scripts/check-migration-history.mjs",
    "db:generate": "node scripts/generate-migration.mjs",
    "db:lock-history": "node scripts/check-migration-history.mjs --write-lock",
    "deploy:development": "opennextjs-cloudflare deploy --env development",
    "deploy:production": "opennextjs-cloudflare deploy --env production",
    "cf:preview": "opennextjs-cloudflare preview --env development",
    "cf:preview:production": "opennextjs-cloudflare preview --env production",
    "dev": "cross-env NODE_ENV=development next dev -H 0.0.0.0 -p 3005",
    "start": "cross-env NODE_ENV=production next start -H 0.0.0.0 -p 3005",
    "lint": "eslint .",
    "smoke:http": "node scripts/http-smoke.mjs",
    "test": "vitest run",
    "test:d1": "node scripts/verify-local-d1.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package --error-on-fail && node scripts/verify-use-scramble-patch.mjs"
  },
  "version": "0.1.0",
  "overrides": {
    "sharp": "0.35.4",
    "next": {
      "postcss": "8.5.26"
    }
  }
}
